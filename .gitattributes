# Unity serializes empty YAML values with a trailing space; preserve its native output.
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
# Bundled upstream license/readme bytes are pinned in the Sokoban source manifest.
Assets/Resources/Sokoban/Licenses/*.txt -text whitespace=-blank-at-eol

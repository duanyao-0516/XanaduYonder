<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Core/GoldMiner/*.cs" Exclude="../../Assets/Scripts/Core/GoldMiner/GoldMinerLevelGenerator.cs;../../Assets/Scripts/Core/GoldMiner/GoldMinerPlanner.cs" Link="Core/GoldMiner/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Runtime/GoldMiner/GoldMinerSave*.cs" Link="Runtime/GoldMiner/%(Filename)%(Extension)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Core/Zuma/**/*.cs" Link="Core/Zuma/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Runtime/Zuma/ZumaSave*.cs" Link="Runtime/Zuma/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Runtime/Zuma/ZumaLevelCache.cs" Link="Runtime/Zuma/ZumaLevelCache.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(ZumaNewtonsoftDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>

    {
      "id": "topic-homesick",
      "title": "思乡",
      "rule": "句中直接怀念故乡、故园亲人，或在篇内明确承担怀乡、望乡、想归而不得的表达。",
      "answers": [
        {"source": ["全唐诗/唐诗三百首.json", 310], "author": "李白", "line": "低头思故乡", "reason": "举头望过明月，低头直接写出思念故乡。"},
        {"source": ["全唐诗/唐诗三百首.json", 210], "author": "杜甫", "line": "月是故乡明", "reason": "同一轮明月因思乡而觉得故乡的月更明，与分散的兄弟相照应。"},
        {"source": ["全唐诗/唐诗三百首.json", 147], "author": "王维", "line": "独在异乡为异客", "reason": "诗人独居异乡，下句逢重阳而思念家中的兄弟。"},
        {"source": ["全唐诗/唐诗三百首.json", 147], "author": "王维", "line": "每逢佳节倍思亲", "reason": "独处异乡的游子在重阳节格外想念家乡亲人。"},
        {"source": ["全唐诗/唐诗三百首.json", 145], "author": "王维", "line": "君自故乡来", "reason": "诗人向家乡来客发问，引出对故乡窗前寒梅的牵念。"},
        {"source": ["全唐诗/唐诗三百首.json", 145], "author": "王维", "line": "应知故乡事", "reason": "诗人向家乡来客打听旧居，牵挂之细落在绮窗前那株寒梅。"},
        {"source": ["全唐诗/唐诗三百首.json", 151], "author": "崔颢", "line": "日暮乡关何处是", "reason": "远眺黄鹤楼外的日暮江景，诗人直接追问故乡在何处。"},
        {"source": ["全唐诗/唐诗三百首.json", 151], "author": "崔颢", "line": "烟波江上使人愁", "reason": "承接日暮追问乡关，江上烟波写出望不见故乡的怅惘。"},
        {"source": ["全唐诗/唐诗三百首.json", 113], "author": "孟浩然", "line": "乡泪客中尽", "reason": "羁旅江上，隔着楚云遥念襄水边的家，泪为思乡而流。"},
        {"source": ["全唐诗/唐诗三百首.json", 51], "author": "王湾", "line": "乡书何处达", "reason": "泊舟北固山下，诗人想把家书寄回故乡洛阳。"},
        {"source": ["全唐诗/唐诗三百首.json", 51], "author": "王湾", "line": "归雁洛阳边", "reason": "承接上句乡书，诗人盼北归的大雁捎信到故乡洛阳。"},
        {"source": ["全唐诗/poet.tang.8000.json", 842], "author": "李白", "line": "何人不起故园情", "reason": "客居洛城听见折柳笛曲，因乐声而想起故园。"},
        {"source": ["全唐诗/poet.tang.10000.json", 550], "author": "高适", "line": "故乡今夜思千里", "reason": "除夕独宿旅馆，转从故乡亲人想念千里游子这一面来写乡愁。"},
        {"source": ["全唐诗/唐诗三百首.json", 88], "author": "李益", "line": "一夜征人尽望乡", "reason": "边地芦管声惊起征人的乡愁，众人都朝故乡遥望。"},
        {"source": ["宋词/ci.song.0.json", 42], "author": "范仲淹", "line": "浊酒一杯家万里", "reason": "戍边人饮一杯浊酒，念及远在万里之外的家。"},
        {"source": ["宋词/ci.song.0.json", 42], "author": "范仲淹", "line": "燕然未勒归无计", "reason": "承接上句万里家乡，战事未定使戍边人有归意而不能归。"},
        {"source": ["全唐诗/唐诗三百首.json", 34], "author": "韦庄", "line": "乡书不可寄", "reason": "羁居听秋雁，想到写给故乡的信无法寄出。"}
      ],
      "rejected": [
        {"source": ["全唐诗/poet.tang.8000.json", 842], "line": "谁家玉笛暗飞声", "reason": "这句的家是疑问语气中的人家。作品下句明写故园之情，笛声本句仍只纳入字面玩法。"}
      ]
    },
    {
      "id": "topic-spring",
      "title": "春景",
      "rule": "描写春季自然物候和景象；季节可由句面点明，也可由同段明确交代。",
      "answers": [
        {"source": ["全唐诗/poet.tang.22000.json", 870], "author": "白居易", "line": "山寺桃花始盛开", "reason": "山下春花已谢，山寺桃花却初开，写同一时令因山地高差而异的春日物候。"},
        {"source": ["全唐诗/poet.song.45000.json", 535], "author": "苏轼", "line": "竹外桃花三两枝", "reason": "题画诗先写竹林外初开的桃花，用少量花枝交代早春。"},
        {"source": ["全唐诗/poet.song.45000.json", 535], "author": "苏轼", "line": "春江水暖鸭先知", "reason": "水温转暖，鸭子下水最先感知，写初春江边的物候。"},
        {"source": ["全唐诗/poet.song.192000.json", 335], "author": "叶绍翁", "line": "春色满园关不住", "reason": "园门闭着，仍可由伸出墙外的杏枝想见满园春色。"},
        {"source": ["全唐诗/poet.song.192000.json", 335], "author": "叶绍翁", "line": "一枝红杏出墙来", "reason": "墙外一枝红杏盛开，从园外可见的花枝写满园春意。"},
